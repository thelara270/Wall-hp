  panelDialogo: {fileID: 423086252}
  textoDialogo: {fileID: 423086253}
  frases:
  - texto: 'Impacto detectado.

      Confirmando estado del usuario: {NOMBRE} operativo.

      Para
      desplazarte utiliza W, A, S y D.'
    mostrarContinuar: 1
    requisito: 1
  - texto: "Falla cr\xEDtica registrada en el sistema de iluminaci\xF3n.\nPara restaurar
      la energ\xEDa, recoge los fusibles presionando F."
    mostrarContinuar: 1
    requisito: 2
  - texto: "M\xF3dulo de fusibles identificado.\nInserta los fusibles recogidos presionando
      E, {NOMBRE}."
    mostrarContinuar: 1
    requisito: 3
  - texto: 'Se requieren fusibles adicionales.

      Cambia entre los espacios de
      inventario con 1, 2 o 3.'
    mostrarContinuar: 1
    requisito: 4
  - texto: "Subsistema de datos averiado.\nAc\xE9rcate al panel y conecta cada docuemento
      con su carpeta correspondiente."
    mostrarContinuar: 1
    requisito: 5
  - texto: 'Acceso al sistema de misiones habilitado.

      Presione TAB para abrir
      el panel de tareas.'
    mostrarContinuar: 1
    requisito: 6
  - texto: "Alerta, {NOMBRE}: se ha detectado una falla en el sistema de ox\xEDgeno.
      Restablece el suministro antes de que el tiempo llegue a cero. Consulta tus
      estad\xEDsticas y el estado de la misi\xF3n desde el panel de tareas."
    mostrarContinuar: 1
    requisito: 7
